# Velocity configuration. Copy to .env and edit:   cp .env.example .env
# Configuration is supplied through the environment. Webhook signing secrets are stored encrypted
# in the database; API keys and session tokens are stored as hashes.
# Values shown are defaults unless marked REQUIRED.

# --- Core (REQUIRED) ----------------------------------------------------------
# Password for the bundled Postgres container (used by docker-compose.yml).
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-run-openssl-rand-hex-24

# OPTIONAL. Secret used to sign sessions, tokens and signed URLs (at least 32
# characters). When unset, one is generated on first start and stored in
# APP_SECRET_FILE (default /data/app-secret in production, ./data/app-secret in
# dev; mode 0600). Keep that file with your backups. An explicit value wins.
# Generate with: openssl rand -hex 32
# Changing it later signs everybody out and invalidates signed upload URLs.
# APP_SECRET=
# APP_SECRET_FILE=/data/app-secret

# OPTIONAL. Public URL users type into the browser (no trailing slash). Used for
# links in emails/webhooks/GitHub callbacks and for CORS/CSRF origin checks.
# When unset: https://$CADDY_DOMAIN if CADDY_DOMAIN is a hostname, else
# http://localhost. An explicit value wins.
# APP_URL=https://velocity.example.com

# --- Reverse proxy (Caddy) ----------------------------------------------------
# Leave unset/empty for plain HTTP on port 80 (http://localhost).
# Set to your domain for automatic HTTPS, e.g. velocity.example.com
# (DNS must point at this host; ports 80 and 443 must be open).
# CADDY_DOMAIN=

# --- Database -----------------------------------------------------------------
# By default docker-compose.yml builds DATABASE_URL from POSTGRES_PASSWORD for
# the bundled postgres service. Uncomment only to use an external Postgres 16.
# DATABASE_URL=postgres://velocity:password@host:5432/velocity

# --- Server -------------------------------------------------------------------
# Port the app listens on inside the container. Caddy proxies to app:3000, so
# leave this alone unless you also edit the Caddyfile.
# PORT=3000

# all    = API + web + background jobs in one process (default)
# web    = API + web only
# worker = background jobs only (used by the `scale` compose profile)
# VELOCITY_ROLE=all

# log level: trace | debug | info | warn | error | fatal
# LOG_LEVEL=info

# Reserved for future use; setting SENTRY_DSN has no effect because Sentry
# reporting is not integrated yet.
# SENTRY_DSN=

# --- Sign-up ------------------------------------------------------------------
# true  = only the first user (setup wizard) and invited members can join.
# false = anyone who can reach the server can create an account.
# DISABLE_SIGNUP=true

# --- Files --------------------------------------------------------------------
# Where uploaded attachments are stored (inside the app_data volume).
# UPLOAD_DIR=/data/uploads
# Maximum upload size in megabytes. Caddy allows 26MB bodies; raise the
# `request_body max_size` in the Caddyfile together with this value.
# MAX_UPLOAD_MB=25
# Where workspace/user export archives are written.
# EXPORT_DIR=/data/exports
# Where optional automatic startup database dumps are written. Docker default: /data/backups.
# BACKUP_DIR=/data/backups

# Optional ClamAV virus scanning of uploads. Requires the compose profile:
#   docker compose --profile clamav up -d
# then uncomment both lines. Without ClamAV, uploads are NOT scanned for malware
# (type allowlist, size limit and sanitised serving still apply).
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# --- Backups ------------------------------------------------------------------
# 1 = run pg_dump into BACKUP_DIR on every non-worker app startup, before
# checking or applying migrations. This also dumps when no migration is pending.
# VELOCITY_BACKUP_BEFORE_MIGRATE=0
# Nightly automatic backups (pg_dump custom format into BACKUP_DIR, run by the
# process that runs background jobs). Defaults: enabled in production only.
# BACKUP_ENABLED=true
# Cron expression, UTC.
# BACKUP_SCHEDULE=0 3 * * *
# After each successful scheduled backup, velocity-*.dump files older than this
# many days are deleted from BACKUP_DIR (nothing else is touched).
# BACKUP_RETENTION_DAYS=14

# --- Proxy / metrics ----------------------------------------------------------
# Compose sets TRUST_PROXY=1 because the app is behind Caddy. Set it only when
# running behind a trusted reverse proxy that supplies X-Forwarded-* headers.
# TRUST_PROXY=0
# Optional Bearer token for the app's /metrics endpoint. Caddy blocks /metrics
# regardless, so scrapers should connect directly to app:3000 on the Compose network.
# METRICS_TOKEN=

# --- GitHub integration (optional; disabled while these are unset) ------------
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# PEM private key; newlines may be written as \n or the value base64-encoded.
# GITHUB_APP_PRIVATE_KEY=
# OAuth client secret of the GitHub App. GITHUB_APP_SECRET is accepted as an
# alias (it is the name used in the spec); set only one of them.
# GITHUB_APP_CLIENT_SECRET=
# Secret configured on the GitHub App's webhook (openssl rand -hex 32).
# GITHUB_WEBHOOK_SECRET=

# --- MCP over HTTP -----------------------------------------------------------
# /mcp is on by default and authenticated by a personal API key alone
# (X-Api-Key: vel_... or Authorization: Bearer vel_...). Set to 0 to disable.
# MCP_HTTP_ENABLED=1
# Optional defense in depth (openssl rand -hex 32, 24+ chars): when set it is also
# required as the Bearer token, and the API key must then be sent in X-Api-Key.
# MCP_HTTP_TOKEN=

# --- Webhooks -----------------------------------------------------------------
# 0 = outbound webhooks may not target private/loopback/link-local addresses
# (SSRF protection). Set to 1 only for trusted internal receivers.
# ALLOW_PRIVATE_WEBHOOK_TARGETS=0

# --- Compose-only (not read by the app) ---------------------------------------
# Image to run for app/worker (default builds from this checkout).
# VELOCITY_IMAGE=ghcr.io/saadiqhorton/velocity:latest

# --- Compose / installer ------------------------------------------------------
# Written by scripts/install/install.sh; safe to edit by hand (or use `velocity config`).
# Host ports published by Caddy (default 80 / 443). Change when something else uses them.
# HTTP_PORT=80
# HTTPS_PORT=443
# With the installer you may omit APP_SECRET / APP_URL: the server generates the secret
# into /data/app-secret and derives APP_URL from CADDY_DOMAIN (https://domain, else http://localhost).
# Host folder for backups (installer sets <install dir>/backups, owned by uid 10001).
# Unset: a Docker named volume (backups_data) is used.
# VELOCITY_BACKUP_DIR=/opt/velocity/backups
