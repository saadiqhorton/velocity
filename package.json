{
  "name": "velocity",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel --filter=@velocity/server --filter=@velocity/web",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && node scripts/check-hex.mjs && node scripts/check-legal.mjs",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @velocity/web test:e2e",
    "test:agent-e2e": "pnpm --filter @velocity/web test:agent-e2e",
    "codegen": "pnpm --filter @velocity/graphql print-schema && pnpm --filter @velocity/web codegen",
    "db:generate": "pnpm --filter @velocity/schema db:generate",
    "db:migrate": "pnpm --filter @velocity/server migrate",
    "seed": "pnpm --filter @velocity/server seed",
    "tokens": "pnpm --filter @velocity/tokens build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.15.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
