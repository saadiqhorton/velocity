# Defaults for `pnpm dev` only (loaded by the dev script; never used by Docker or production).
# Matches the dev Postgres container in CONTRIBUTING.md. Override any value in a git-ignored
# apps/server/.env.local, or by exporting it in your shell.
DATABASE_URL=postgres://velocity:velocity@localhost:54320/velocity
# The Vite dev client origin: cookie-auth WebSockets need APP_URL to match it.
APP_URL=http://localhost:5173
PORT=3100
