{
  "name": "@velocity/web",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "graphql-codegen --config codegen.ts && node scripts/sync-persisted.mjs && vite build",
    "preview": "vite preview",
    "codegen": "graphql-codegen --config codegen.ts && node scripts/sync-persisted.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@velocity/ui": "workspace:*",
    "@velocity/tokens": "workspace:*",
    "@velocity/graphql": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@apollo/client": "^3.14.1",
    "graphql": "^16.14.2",
    "graphql-ws": "^6.3.0",
    "react-router-dom": "^6.30.6",
    "zustand": "^5.0.15",
    "@tanstack/react-virtual": "^3.14.13",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@fontsource-variable/inter": "^5.3.0",
    "clsx": "^2.1.1",
    "@velocity/schema": "workspace:*"
  },
  "devDependencies": {
    "vite": "^8.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@playwright/test": "^1.63.0",
    "@axe-core/playwright": "^4.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^26.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/dom": "^10.4.0",
    "@graphql-typed-document-node/core": "^3.2.0"
